# PostgreSQL / Supabase (configured in a later phase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Better Auth (configured in a later phase)
BETTER_AUTH_SECRET="replace-with-a-generated-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Upstash Redis (configured in a later phase)
UPSTASH_REDIS_REST_URL="https://REPLACE_ME.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"
