generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app_private"]
}

enum MenfessStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED

  @@schema("app_private")
}

enum ModerationAction {
  APPROVE
  REJECT
  MARK_PUBLISHED

  @@schema("app_private")
}

// Generated from Better Auth 1.7.12 with the official `auth generate` CLI.
// Physical mappings and native PostgreSQL types were added after generation.
model User {
  id             String          @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name           String          @db.VarChar(120)
  email          String          @db.VarChar(320)
  emailVerified  Boolean         @default(false) @map("email_verified")
  image          String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  role           String          @default("none") @db.VarChar(32)
  sessions       Session[]
  accounts       Account[]
  moderationLogs ModerationLog[]

  @@unique([email])
  @@map("auth_user")
  @@schema("app_private")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
  @@schema("app_private")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
  @@schema("app_private")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([expiresAt])
  @@map("auth_verification")
  @@schema("app_private")
}

model Category {
  id        String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  slug      String    @unique @db.VarChar(32)
  label     String    @db.VarChar(50)
  sortOrder Int       @unique @map("sort_order") @db.SmallInt
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  menfess   Menfess[]

  @@map("category")
  @@schema("app_private")
}

model Menfess {
  id                     String          @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  categoryId             String          @map("category_id") @db.Uuid
  message                String          @db.VarChar(1000)
  trackingCodeDigest     Bytes           @unique @map("tracking_code_digest") @db.ByteA
  trackingCodeKeyVersion Int             @map("tracking_code_key_version") @db.SmallInt
  trackingUrlDigest      Bytes           @unique @map("tracking_url_digest") @db.ByteA
  trackingUrlKeyVersion  Int             @map("tracking_url_key_version") @db.SmallInt
  status                 MenfessStatus   @default(PENDING)
  version                Int             @default(0)
  submittedAt            DateTime        @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt            DateTime?       @map("published_at") @db.Timestamptz(6)
  publicationReference   String?         @map("publication_reference") @db.VarChar(500)
  category               Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  moderationLogs         ModerationLog[]

  @@index([status, submittedAt(sort: Desc)])
  @@index([categoryId, submittedAt(sort: Desc)])
  @@map("menfess")
  @@schema("app_private")
}

model ModerationLog {
  id             String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  menfessId      String           @map("menfess_id") @db.Uuid
  actorUserId    String           @map("actor_user_id") @db.Uuid
  idempotencyKey String           @unique @map("idempotency_key") @db.Uuid
  action         ModerationAction
  fromStatus     MenfessStatus    @map("from_status")
  toStatus       MenfessStatus    @map("to_status")
  note           String?          @db.VarChar(1000)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  menfess        Menfess          @relation(fields: [menfessId], references: [id], onDelete: Restrict)
  actor          User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([menfessId, action])
  @@index([menfessId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([toStatus, createdAt(sort: Desc)])
  @@map("moderation_log")
  @@schema("app_private")
}

// Internal abuse-control state. Application traffic reaches this table only
// through app_private.consume_rate_limit(); bawean_app has no direct table
// privileges. Plaintext client addresses are never persisted. The model is
// ignored so Prisma Client cannot offer direct CRUD that bypasses the function.
model RateLimitBucket {
  scope                String   @db.VarChar(16)
  identifierKeyVersion Int      @map("identifier_key_version") @db.SmallInt
  identifierDigest     Bytes    @map("identifier_digest") @db.ByteA
  windowStartedAt      DateTime @map("window_started_at") @db.Timestamptz(6)
  requestCount         Int      @map("request_count")
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
  updatedAt            DateTime @map("updated_at") @db.Timestamptz(6)

  @@id([scope, identifierKeyVersion, identifierDigest, windowStartedAt], map: "rate_limit_bucket_pkey")
  @@index([expiresAt], map: "rate_limit_bucket_expires_at_idx")
  @@ignore
  @@map("rate_limit_bucket")
  @@schema("app_private")
}
