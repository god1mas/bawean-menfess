# PostgreSQL / Supabase (server-only; the approved CA is packaged in certificates/)
# Copy the exact hosts from the Supabase Dashboard's Connect dialog. The shared
# pooler cluster hostname must not be guessed from the region.
DATABASE_URL="postgresql://bawean_app.hqupjaaagwpafeuwyixe:RUNTIME_ROLE_PASSWORD@POOLER_HOST_FROM_DASHBOARD:6543/postgres?pgbouncer=true&sslmode=verify-full&sslrootcert=certificates/supabase-prod-ca-2021.crt"

# Preferred for Prisma CLI/migrations when the machine has IPv6 connectivity.
DIRECT_URL="postgresql://postgres:DB_PASSWORD@db.hqupjaaagwpafeuwyixe.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=certificates/supabase-prod-ca-2021.crt"

# IPv4-only migration alternative: replace DIRECT_URL with the exact shared
# session-pooler URL (port 5432) copied from the Connect dialog.
# DIRECT_URL="postgresql://postgres.hqupjaaagwpafeuwyixe:DB_PASSWORD@POOLER_HOST_FROM_DASHBOARD:5432/postgres?sslmode=verify-full&sslrootcert=certificates/supabase-prod-ca-2021.crt"

# Future tracking credentials (server-only; generate independent random keys).
TRACKING_CODE_HMAC_KEY_V1="replace-with-generated-secret"
TRACKING_URL_HMAC_KEY_V1="replace-with-different-generated-secret"

# Better Auth (server-only; use a unique random secret of at least 32 bytes)
BETTER_AUTH_SECRET="replace-with-a-generated-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Upstash Redis (configured in a later phase)
UPSTASH_REDIS_REST_URL="https://REPLACE_ME.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"
